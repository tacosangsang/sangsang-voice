# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NOTION_TOKEN: 노션 통합(Internal integration) 토큰. 컷표 페이지를 그 통합에 공유해야 한다.
# 없으면 저장소에 든 대본 사본(src/data/platingScript.ts)을 쓴다.
NOTION_TOKEN=""
# NOTION_SCRIPT_PAGE_ID: 컷표 페이지 id. 비우면 PLATING 컷표.
NOTION_SCRIPT_PAGE_ID=""

# GITHUB_TOKEN: 생성 음성을 깃허브에 저장하고 불러온다. fine-grained 토큰, 대상 저장소 Contents 읽기·쓰기.
# 없으면 음성은 그 브라우저(IndexedDB)에만 남는다.
GITHUB_TOKEN=""
# 저장 위치는 tacosangsang/sangsang-voice 의 recordings 브랜치(기본값). 바꿀 때만 서버 환경 변수
# GITHUB_RECORDINGS_REPO(owner/name), GITHUB_RECORDINGS_BRANCH 를 따로 넣는다. 여기에 칸을 두지 않는 이유:
# AI Studio가 이 파일의 칸마다 Secret 입력을 띄워, 토큰을 저장소·브랜치 칸에 넣는 실수가 났다(2026-11-06).
